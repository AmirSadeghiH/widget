{
  "name": "ai-support-widget",
  "version": "7.0.0",
  "private": true,
  "description": "Eleven standalone, accessible Persian support-widget themes.",
  "scripts": {
    "build": "python3 scripts/build_widgets.py",
    "check": "python3 scripts/build_widgets.py --check && node --test tests/source.test.cjs",
    "test": "npm run check && playwright test",
    "test:ui": "playwright test",
    "preview": "node scripts/preview-server.cjs",
    "test:unit": "node --test tests/source.test.cjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.0",
    "@sparticuz/chromium": "153.0.0"
  },
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  }
}
